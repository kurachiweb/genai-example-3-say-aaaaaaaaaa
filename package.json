{
	"name": "say-aaaaaaaaaa",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"deploy": "npm run build && wrangler deploy",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"eslint --fix"
		],
		"*.{ts,tsx,js,jsx,json,css,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.13.7",
		"inversify": "^8.2.3",
		"lucide-react": "^1.44.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.7",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"wrangler": "^4.131.0"
	}
